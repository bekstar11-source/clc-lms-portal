rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- YORDAMCHI FUNKSIYALAR ---

    // 1. Foydalanuvchi ma'lumotlarini olish
    function getUserData() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }

    // 2. Admin ekanligini tekshirish
    function isAdmin() {
      return getUserData().role == 'admin';
    }

    // 3. O'qituvchi ekanligini tekshirish
    function isTeacher() {
      return getUserData().role == 'teacher';
    }
    
    // 4. Admin YOKI O'qituvchi ekanligini tekshirish
    function isStaff() {
      return isAdmin() || isTeacher();
    }

    // --- KOLLEKSIYALAR BO'YICHA QOIDALAR ---

    // 1. O'QUVCHILAR (Students)
    match /students/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    // 2. GURUHLAR (Groups)
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isStaff();
    }

    // 3. DARSLAR (Lessons)
    match /lessons/{lessonId} {
      allow read: if request.auth != null;
      allow write: if isStaff();
    }

    // 4. BAHOLAR (Grades) - 🔥 O'ZGARTIRILGAN QISM
    match /grades/{gradeId} {
      // Hamma o'qiy oladi
      allow read: if request.auth != null;
      
      // Yaratish va O'chirish: Faqat Ustoz va Admin
      allow create, delete: if isStaff();
      
      // O'zgartirish (Update): 
      allow update: if 
        // 1-HOLAT: Ustoz yoki Admin hamma narsani o'zgartira oladi
        isStaff() 
        || 
        // 2-HOLAT: Student o'zgartirmoqchi bo'lsa
        (
          // Bu baho shu studentniki ekanligini tekshiramiz
          request.auth.uid == resource.data.studentId &&
          
          // Student faqat va faqat 'status' maydonini o'zgartirayotganini tekshiramiz
          // (Bahoni o'zi 5 ga to'g'rilab olmasligi uchun)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        );
    }

    // 5. E'LONLAR (Announcements)
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}